FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY backend/ ./

RUN uv sync --frozen

EXPOSE 8000

CMD ["uv", "run", "--frozen", "uvicorn", "hmde.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
